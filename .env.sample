SEARCH_CONDITIONS=<SEARCH-CONDITIONS-HERE>
BOT_TOKEN=<BOT-TOKEN-HERE>
# Private chat id, @channelusername, or -100... channel id.
# Comma-separated for multiple destinations (e.g. channel + personal chat).
BOT_CHATID=<CHAT-ID-OR-@CHANNEL>
EXCLUDE_TITLE=<COMMA-SEPARATED-WORDS-TO-SKIP>
# Gallery photos per listing (1-10). Default 4.
MAX_IMAGES=4
HTTP_PROXY=<HTTP-PROXY-HERE>
HTTPS_PROXY=<HTTPS-PROXY-HERE>
